# Same PostgreSQL URL used by backend/.env and Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vayusetu?sslmode=require
VAYUSETU_AUTO_ETL=true

# Keep evidence of the latest policy review/permission for implemented sources.
VAYUSETU_CONTACT_EMAIL=data-team@example.gov.in
VAYUSETU_AIRINDIAEXPRESS_AUTHORIZATION_CONFIRMED=false
VAYUSETU_AIRINDIAEXPRESS_AUTHORIZATION_REFERENCE=
VAYUSETU_AIRINDIAEXPRESS_POLICY_REVIEWED_ON=YYYY-MM-DD
VAYUSETU_AKASAAIR_AUTHORIZATION_CONFIRMED=false
VAYUSETU_AKASAAIR_AUTHORIZATION_REFERENCE=
VAYUSETU_AKASAAIR_POLICY_REVIEWED_ON=YYYY-MM-DD
VAYUSETU_SPICEJET_AUTHORIZATION_CONFIRMED=false
VAYUSETU_SPICEJET_AUTHORIZATION_REFERENCE=
VAYUSETU_SPICEJET_POLICY_REVIEWED_ON=YYYY-MM-DD
VAYUSETU_YATRA_AUTHORIZATION_CONFIRMED=false
VAYUSETU_YATRA_AUTHORIZATION_REFERENCE=
VAYUSETU_YATRA_POLICY_REVIEWED_ON=YYYY-MM-DD
